# Copy to .env and replace all placeholders. Never commit .env.
DATABASE_URL="postgresql://servicedesk:replace-with-your-password@localhost:5432/servicedesk?schema=public"
AUTH_URL="http://localhost:3000"
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Docker Compose PostgreSQL (match the credentials in DATABASE_URL).
POSTGRES_DB="servicedesk"
POSTGRES_USER="servicedesk"
POSTGRES_PASSWORD=""
POSTGRES_PORT="5432"

# One-time setup: npm run db:bootstrap. Password must have at least 12 characters.
BOOTSTRAP_ADMIN_NAME="Администратор"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Optional, explicit demo only: npm run db:seed. Never required for normal use.
SEED_DEMO_PASSWORD=""
