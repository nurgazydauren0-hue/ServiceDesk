# Скопируйте в .env только при его отсутствии. Не добавляйте .env в Git.
# Для одной общей базы укажите одинаковую строку подключения на всех компьютерах.
# Формат: postgresql://USER:PASSWORD@SHARED_HOST:5432/DATABASE?schema=public
# Параметры TLS возьмите у администратора выбранной PostgreSQL.
DATABASE_URL=""
# Приложение запускается локально, даже если база находится на другом сервере.
AUTH_URL="http://localhost:3000"
# Создайте один раз, если секрет ещё не задан, и сохраняйте при перезапусках:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Узлам одного сайта нужен одинаковый AUTH_SECRET.
AUTH_SECRET=""

# Только для отдельной локальной PostgreSQL через Docker Compose.
# Значения должны соответствовать локальной DATABASE_URL.
POSTGRES_DB="servicedesk"
POSTGRES_USER="servicedesk"
POSTGRES_PASSWORD=""
POSTGRES_PORT="5432"

# Для новой базы: npm.cmd run db:bootstrap один раз после db:setup.
# Для явной смены пароля существующего ADMIN: npm.cmd run db:admin:password.
# Администратор: минимум 11 символов. Регистрация и профиль: минимум 12.
# Эти команды не запускаются автоматически при старте приложения.
BOOTSTRAP_ADMIN_NAME="Администратор"
BOOTSTRAP_ADMIN_EMAIL="admin@servicedesk.local"
BOOTSTRAP_ADMIN_PASSWORD=""

# Только для отдельной демонстрационной базы: npm.cmd run db:seed.
SEED_DEMO_PASSWORD=""
